spring.application.name=backend

# Database
spring.datasource.url=jdbc:postgresql://localhost:5432/your_db
spring.datasource.username=your_username
spring.datasource.password=your_password

# JWT
jwt.secret=your_jwt_secret
jwt.expiration=86400000

# Email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=your_verified_sender@example.com
SMTP_STARTTLS_ENABLE=true
SMTP_SSL_ENABLE=false

# HTTPS production
COOKIE_SECURE=true

# Admin bootstrap
ADMIN_EMAIL=keukeukkeu47@gmail.com
ADMIN_PASSWORD=change-this-password

# Temporary test accounts. Set false before production deployment.
TEST_ACCOUNTS_ENABLED=true
TEST_ACCOUNT_PASSWORD=Test1234!

# 실제 값은 application.properties에 작성 (gitignore됨)
